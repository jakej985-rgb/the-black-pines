prompt_message = "[E] Read Torn Journal Entry"
inspection_text = "HUNTER'S WATERLOGGED JOURNAL:\n\n'Oct 28: It circled the tent three times before dawn. Heavier than any bear. It doesn't walk like a four-legged animal. It throws heavy rocks against the cedar trunks from 30 yards out, testing us. Miller shot his 30-06 into the dark. It didn't scream... it laughed. A low, rolling vibration in your chest. God help us, we are leaving at sunrise.'\n(Spent brass rifle cartridges are scattered everywhere in the dirt)."
clue_title = "Waterlogged Hunter's Journal"

