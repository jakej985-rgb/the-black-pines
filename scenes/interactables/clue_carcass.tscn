prompt_message = "[E] Inspect Mutilated Remains"
inspection_text = "A full-grown bull elk, snapped clean in half. The spine is twisted backward with catastrophic blunt force. The ribcage was pried apart like toothpicks by immense clawed hands. The meat was left untouched—only the skull and long leg bones were shattered to harvest bone marrow. The carcass is still warm in the freezing night."
clue_title = "Mutilated Bull Elk"

