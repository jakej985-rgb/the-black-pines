[node name="ClueCarcass" type="StaticBody3D"]
collision_layer = 1
collision_mask = 0
script = ExtResource("1_clue")
prompt_message = "[E] Inspect Mutilated Remains"
inspection_text = "A full-grown bull elk, snapped clean in half. The spine is twisted backward at a 90-degree angle with catastrophic blunt trauma. The ribcage was pried apart like toothpicks by immense clawed hands. The meat was left untouched—only the skull and long leg bones were shattered to harvest bone marrow. The carcass is still warm in the freezing night."
clue_title = "Mutilated Bull Elk"

