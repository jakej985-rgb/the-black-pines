script = ExtResource("1_clue")
prompt_message = "[E] Inspect Animal Remains"
inspection_text = "A full-grown bull elk carcass, completely broken. The spine was snapped clean backward with tremendous brute force. The ribcage was pried open by large hands with claws. It wasn't hunted for meat—the skull and femur were cracked open solely for bone marrow. The body is still warm."
clue_title = "Mutilated Bull Elk"

